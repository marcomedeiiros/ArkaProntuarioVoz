# Modelo do server/.env. NUNCA coloque valores reais aqui: este arquivo vai para o GitHub.
# O jeito mais fácil de criar o .env com segredos fortes é:
#   npm --prefix server run setup:env -- --anthropic-key --resend
# (ou copie este arquivo para server/.env e preencha à mão)

# postgresql://USUARIO:SENHA@localhost:5432/BANCO?schema=public
DATABASE_URL=

# Pelo menos 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Criptografa os segredos salvos no painel da Arka (ex.: chave da IA). Gerada pelo setup:env.
SETTINGS_ENCRYPTION_KEY=

# Chave da API da Anthropic (console.anthropic.com > API Keys). Também pode ser cadastrada
# pela conta da Arka em Configurações, sem mexer neste arquivo.
ANTHROPIC_API_KEY=

PORT=3333
CLIENT_URL=http://localhost:5173

# Transcrição local (Whisper)
WHISPER_MODEL=onnx-community/whisper-large-v3-turbo
WHISPER_DTYPE=q8
WHISPER_OFFLINE=0

# E-mail (esqueci a senha). Em branco no desenvolvimento: os e-mails vão para server/.mail-outbox.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<API key re_...>
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Conta da Arka desta máquina (libera clínicas e define os módulos de cada uma; não pertence a clínica).
# A API cria a conta ao subir, se ela ainda não existir no banco.
# Nunca altera uma conta existente. Preencha com: npm run setup:env -- --admin (a senha não aparece na tela).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Opcional: senhas da clínica de demonstração (npm --prefix server run db:seed).
# Em branco, o seed gera senhas fortes e salva em server/.demo-credentials.
SEED_ADMIN_PASSWORD=
SEED_SECRETARY_PASSWORD=
