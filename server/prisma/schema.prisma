// Banco da PLATAFORMA (schema public): contas, clínicas, liberação, permissões e configurações.
// Os dados de cada clínica (pacientes, consultas, financeiro) NÃO ficam aqui: cada clínica tem o
// próprio schema, definido em ./tenant/schema.prisma e criado quando a Arka libera o cadastro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  SECRETARY
}

/// Situação da clínica no SaaS. Cadastros pelo site nascem PENDING e só usam o sistema depois que a Arka libera.
enum ClinicStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model Clinic {
  id               String                 @id @default(cuid())
  name             String
  status           ClinicStatus           @default(ACTIVE)
  /// Motivo da recusa ou da suspensão (mostrado para a clínica ao tentar entrar).
  statusReason     String?
  reviewedAt       DateTime?
  /// Abas que a Arka liberou para esta clínica (chaves do catálogo em server/src/lib/modules.ts).
  modules          String[]               @default(["PATIENTS", "CONSULTATIONS", "FINANCE", "TEAM"])
  /// Quando o schema próprio da clínica foi criado (null = ainda não tem espaço de dados).
  provisionedAt    DateTime?
  /// Quando os dados de antes da separação por clínica foram copiados para o schema dela.
  legacyImportedAt DateTime?
  createdAt        DateTime               @default(now())
  users            User[]
  rolePermissions  ClinicRolePermission[]
}

model User {
  id             String               @id @default(cuid())
  /// Null só para contas da Arka, que não pertencem a nenhuma clínica.
  clinicId       String?
  clinic         Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name           String
  email          String               @unique
  passwordHash   String
  role           Role
  active         Boolean              @default(true)
  /// Incrementado para invalidar na hora todos os tokens da pessoa
  /// (sair de todos os dispositivos, troca de senha, desativação).
  tokenVersion   Int                  @default(0)
  /// Conta da empresa (Arka): libera clínicas e define os módulos de cada uma. Não vê dados de clínicas.
  platformAdmin  Boolean              @default(false)
  createdAt      DateTime             @default(now())
  passwordResets PasswordResetToken[]
}

/// Link de "esqueci a senha". Só o hash SHA-256 do token fica no banco: quem ler o banco não
/// consegue usar o link. Vale uma vez e expira em poucos minutos.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// O que cada cargo acessa DENTRO de uma clínica. Definido pela administração da clínica,
/// sempre limitado aos módulos que a Arka liberou para ela.
model ClinicRolePermission {
  clinicId   String
  clinic     Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role       Role
  /// Chave de uma aba do catálogo (server/src/lib/modules.ts).
  permission String

  @@id([clinicId, role, permission])
}

/// Configurações da plataforma (chave/valor). Valores secretos são guardados criptografados.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
