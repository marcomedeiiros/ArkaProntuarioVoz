# ==========================================================
#  Prontuário por Voz · Arka Tecnologia
#  Nunca versione segredos, dados de pacientes ou builds.
#  Antes de cada push: `git status` e, se possível, `gitleaks detect`.
# ==========================================================

# --- Segredos e variáveis de ambiente ---
.env
.env.*
*.env
!/.env.example
# Modelo antigo do server: não versionar (pode ter valores reais). O modelo limpo é server/env.example.
server/.env.example
.npmrc
.netrc
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials*.json
service-account*.json

# --- Credenciais e e-mails gerados localmente ---
# Logins da clínica de demonstração (gerados pelo seed)
.demo-credentials
# E-mails de desenvolvimento (têm links de redefinição de senha)
.mail-outbox/
*.eml

# --- Banco de dados local e dumps (podem conter dados de pacientes) ---
.pgdata/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.backup
backups/
exports/
# Planilhas exportadas costumam ter dados de pacientes
*.csv
*.xlsx
*.xls

# --- Modelos de IA baixados (gigabytes) ---
.models/
*.onnx
*.onnx_data

# --- Uploads, gravações e arquivos gerados em runtime ---
uploads/
recordings/
*.wav
*.webm
*.mp3
*.m4a
*.ogg

# --- Código gerado (Prisma da clínica) ---
server/src/generated/

# --- Dependências e builds ---
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
coverage/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editores e sistema operacional ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# --- Configurações locais de ferramentas (Claude Code etc.) ---
.claude/
